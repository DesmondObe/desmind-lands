# API role: member of lands_app, subject to row-level security.
DATABASE_URL=postgres://lands_api:lands_api@localhost:5433/lands
# Database owner: migrations and the background worker. Never given to the API server.
SYSTEM_DATABASE_URL=postgres://postgres:postgres@localhost:5433/lands
PORT=4000
# Where the web app is served, for links in emails and CORS.
WEB_ORIGIN=http://localhost:3000
# Email (worker): Resend or SMTP. Neither: printed to the worker's console.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM="DesMind Lands <lands@desmindlabs.com>"
# File storage: any S3-compatible service. Unset: files go to STORAGE_DIR (development only).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_DIR=.uploads
